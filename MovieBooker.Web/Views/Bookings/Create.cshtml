@model MovieBooker.Application.DTOs.CreateBookingDto

<h2>💺 Select Seat</h2>

<form method="post">
    <input type="hidden" asp-for="ShowTimeId" />

    <label>Name</label><br />
    <input asp-for="CustomerName" required /><br /><br />

    <label>Seat Number (e.g. A1, A2)</label><br />
    <input asp-for="SeatNumber" required /><br /><br />

    <button type="submit">🎟 Confirm Booking</button>
</form>
