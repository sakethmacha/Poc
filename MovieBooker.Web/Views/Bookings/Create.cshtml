@model MovieBooker.Application.DTOs.CreateBookingDto

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet">

<h2 class="text-center my-4">🎟 Select Your Seats</h2>

<form method="post">

    <input type="hidden" asp-for="ShowTimeId" />

    <!-- Customer Name -->
    <div class="mb-4 text-center">
        <label class="form-label fw-bold">Your Name</label>
        <input asp-for="CustomerName"
               class="form-control w-50 mx-auto"
               required />
    </div>

    <!-- Screen -->
    <div class="text-center mb-3">
        <div class="bg-secondary text-white py-2 rounded w-75 mx-auto">
            SCREEN THIS WAY
        </div>
    </div>

    <!-- Seat Grid -->
    <div class="container">
        <div class="row justify-content-center g-2">

            @foreach (var seat in ViewBag.Seats)
            {
                var isBooked = seat.IsBooked;

                <div class="col-3 col-sm-2 col-md-1 text-center">
                    <input type="checkbox"
                           class="btn-check"
                           name="SeatIds"
                           value="@seat.Id"
                           id="seat_@seat.Id"
                           @(isBooked ? "disabled" : "") />

                    <label class="btn
                               @(isBooked ? "btn-danger disabled" : "btn-outline-secondary")"
                           for="seat_@seat.Id"
                           style="width:50px">
                        @seat.SeatNumber
                    </label>
                </div>
            }

        </div>
    </div>

    @* <!-- Legend -->
    <div class="d-flex justify-content-center gap-4 mt-4">
        <span><span class="btn btn-outline-secondary btn-sm"></span> Available</span>
        <span><span class="btn btn-success btn-sm"></span> Selected</span>
        <span><span class="btn btn-danger btn-sm"></span> Booked</span>
    </div> *@

    <!-- Submit -->
    <div class="text-center mt-4">
        <button type="submit"
                class="btn btn-primary btn-lg px-5">
            Confirm Booking
        </button>
    </div>

</form>
