@model MovieBooker.Application.DTOs.BookingDto

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet">

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-lg border-0">
                <div class="card-header text-center bg-success text-white">
                    <h4 class="mb-0">
                        @(Model.IsCancelled ? "❌ Booking Cancelled" : "✅ Booking Confirmed")
                    </h4>
                </div>

                <div class="card-body">

                    <!-- Movie -->
                    <div class="mb-3">
                        <span class="fw-bold text-muted">🎬 Movie</span>
                        <div class="fs-5">@Model.Movie</div>
                    </div>

                    <!-- Seats -->
                    <div class="mb-3">
                        <span class="fw-bold text-muted">💺 Seats</span>
                        <div class="d-flex flex-wrap gap-2 mt-1">
                            @foreach (var seat in Model.Seats)
                            {
                                <span class="badge bg-primary fs-6 px-3 py-2">
                                    @seat
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Status -->
                    <div class="mb-4">
                        <span class="fw-bold text-muted">📌 Status</span>
                        <div>
                            <span class="badge
                                @(Model.IsCancelled ? "bg-danger" : "bg-success")
                                fs-6 px-3 py-2">
                                @(Model.IsCancelled ? "Cancelled" : "Confirmed")
                            </span>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex justify-content-between">
                        <a href="/Movies/Index" class="btn btn-outline-secondary">
                            ⬅ Back to Movies
                        </a>

                        @if (!Model.IsCancelled)
                        {
                            <a href="/Bookings/Cancel/@Model.Id"
                               class="btn btn-danger">
                                ❌ Cancel Booking
                            </a>
                        }
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>
